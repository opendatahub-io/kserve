configure_vllm_openssl_profile() {
  local min_protocol="$1"
  local base_config="${OPENSSL_CONF:-}"
  local openssl_dir=""
  local rendered_config=""
  local init_section=""
  local ssl_section=""
  local policy_section=""

  if [ -z "${base_config}" ] && command -v openssl >/dev/null 2>&1; then
    openssl_dir="$(openssl version -d | sed -n 's/^OPENSSLDIR: "\(.*\)"$/\1/p')"
    if [ -n "${openssl_dir}" ]; then
      base_config="${openssl_dir}/openssl.cnf"
    fi
  fi

  rendered_config="$(mktemp /tmp/kserve-openssl-XXXXXX.cnf)" || {
    echo "[tls-profile] error: unable to create the vLLM OpenSSL configuration" >&2
    return 1
  }
  if [ -n "${base_config}" ] && [ -r "${base_config}" ]; then
    cat "${base_config}" > "${rendered_config}" || return 1
  fi

  openssl_config_value() {
    local target_section="$1"
    local target_key="$2"
    awk -v target_section="${target_section}" -v target_key="${target_key}" '
      function trim(value) {
        sub(/^[[:space:]]+/, "", value)
        sub(/[[:space:]]+$/, "", value)
        return value
      }
      /^[[:space:]]*[#;]/ { next }
      /^[[:space:]]*\[/ {
        section = $0
        sub(/^[[:space:]]*\[/, "", section)
        sub(/\].*$/, "", section)
        section = trim(section)
        next
      }
      {
        separator = index($0, "=")
        if (separator == 0 || section != target_section) {
          next
        }
        key = trim(substr($0, 1, separator - 1))
        if (key == target_key) {
          value = trim(substr($0, separator + 1))
        }
      }
      END {
        if (value != "") {
          print value
        }
      }
    ' "${rendered_config}"
  }

  init_section="$(openssl_config_value "" "openssl_conf")"
  if [ -z "${init_section}" ]; then
    init_section="kserve_tls_init"
    printf '\nopenssl_conf = %s\n' "${init_section}" >> "${rendered_config}" || return 1
  fi

  ssl_section="$(openssl_config_value "${init_section}" "ssl_conf")"
  if [ -z "${ssl_section}" ]; then
    ssl_section="kserve_tls_ssl"
    printf '\n[%s]\nssl_conf = %s\n' "${init_section}" "${ssl_section}" >> "${rendered_config}" || return 1
  fi

  policy_section="$(openssl_config_value "${ssl_section}" "system_default")"
  if [ -z "${policy_section}" ]; then
    policy_section="kserve_tls_system_default"
    printf '\n[%s]\nsystem_default = %s\n' "${ssl_section}" "${policy_section}" >> "${rendered_config}" || return 1
  fi

  printf '\n[%s]\nMinProtocol = %s\n' "${policy_section}" "${min_protocol}" >> "${rendered_config}" || return 1
  export OPENSSL_CONF="${rendered_config}"
}
configure_vllm_openssl_profile "__KSERVE_OPENSSL_MIN_PROTOCOL__" || exit 1
unset -f configure_vllm_openssl_profile openssl_config_value
